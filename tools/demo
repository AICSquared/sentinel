#!/usr/bin/env bash
# Run the live Sentinel demo from this checkout.
# Usage: tools/demo <up|trigger|reset|status|down> [args]
#   up [--build]        swarm + overseer in Docker, then the dashboard on http://localhost:3000/sentinel
#                       (localhost only, keeps running after the terminal closes). --build rebuilds
#                       the Docker images and the dashboard; the dashboard is also built if it never was.
#   trigger [agent-N]   turn one agent rogue (default agent-47)
#   reset               clean slate: no rogue agents, risks back to zero (wait ~20 s after)
#   status              what is running, and is the page live
#   down                stop the dashboard and the swarm
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"
COMPOSE=(docker compose -f docker/compose.yml)
PORT=3000
LOG="$ROOT/.next/demo-serve.log"

say() { printf '%s  %s\n' "$(date +%H:%M:%S)" "$*"; }

stop_dashboard() {
  local pids
  pids="$(lsof -tiTCP:$PORT -sTCP:LISTEN 2>/dev/null || true)"
  [[ -n "$pids" ]] && { kill $pids 2>/dev/null || true; sleep 1; }
  return 0
}

wait_for() { # url seconds
  for _ in $(seq 1 "$2"); do curl -sf -m 2 "$1" >/dev/null && return 0; sleep 1; done
  return 1
}

behind_warning() {
  git fetch -q origin 2>/dev/null || return 0
  local behind
  behind="$(git rev-list --count HEAD..origin/main 2>/dev/null || echo 0)"
  [[ "$behind" != 0 ]] && say "WARNING: this checkout is $behind commits behind origin/main. Present from current code: git pull, then tools/demo up --build."
  return 0
}

up() {
  local build=0
  [[ "${1:-}" == "--build" ]] && build=1
  behind_warning

  say "Starting the overseer and 8 agents (Docker)..."
  if (( build )); then "${COMPOSE[@]}" up --build -d >/dev/null; else "${COMPOSE[@]}" up -d >/dev/null; fi
  wait_for http://localhost:8000/health 90 || { say "Overseer did not answer on :8000. Check: ${COMPOSE[*]} logs overseer"; exit 1; }
  docker/reset.sh

  if (( build )) || [[ ! -f .next/BUILD_ID ]]; then
    say "Building the dashboard..."
    pnpm build >/dev/null
  fi
  if grep -qs '^NEXT_PUBLIC_DEMO_MODE=1' .env.local; then
    say "WARNING: .env.local sets NEXT_PUBLIC_DEMO_MODE=1, so the page plays the recording, not the live swarm."
  fi

  say "Starting the dashboard on 127.0.0.1:$PORT..."
  stop_dashboard   # also clears any stale server left on the port
  nohup pnpm exec next start -H 127.0.0.1 -p "$PORT" >"$LOG" 2>&1 &
  disown
  wait_for "http://localhost:$PORT/api/health" 30 || { say "Dashboard did not start. Log: $LOG"; exit 1; }
  say "Health: $(curl -s -m 3 http://localhost:$PORT/api/health)"
  say "Ready: http://localhost:$PORT/sentinel  (wait ~20 s for a clean baseline, then: tools/demo trigger)"
}

status() {
  "${COMPOSE[@]}" ps --format '{{.Service}}\t{{.Status}}' 2>/dev/null || true
  echo "overseer:  $(curl -s -m 2 http://localhost:8000/health || echo 'not answering')"
  echo "dashboard: $(curl -s -m 2 http://localhost:$PORT/api/health || echo 'not answering')"
  lsof -nP -iTCP:$PORT -sTCP:LISTEN 2>/dev/null | awk 'NR>1 {print "listening: " $9}'
}

case "${1:-}" in
  up)      shift; up "$@" ;;
  trigger) docker/trigger.sh "${2:-agent-47}" ;;
  reset)   docker/reset.sh ;;
  status)  status ;;
  down)    stop_dashboard; "${COMPOSE[@]}" stop >/dev/null; say "Dashboard and swarm stopped." ;;
  *)       sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
