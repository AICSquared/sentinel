# Copy to .env.local for local work. On Vercel, the Supabase integration fills these in.

# Supabase > Project Settings > API (publishable and secret keys; the legacy anon and service_role names also work)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# 1 = every track uses its bundled sample data (src/app/<track>/_data/). Turns on by itself without Supabase keys.
NEXT_PUBLIC_DEMO_MODE=
